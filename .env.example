# Database
DATABASE_URL="file:./dev.db"

# NextAuth - generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-at-least-32-chars"
# IMPORTANT: Set this to your actual domain in production
AUTH_URL="https://yourdomain.com"

# OneSignal - push notifications + email (recommended)
# Get from: https://app.onesignal.com -> Your App -> Settings -> Keys & IDs
NEXT_PUBLIC_ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_API_KEY="your-onesignal-rest-api-key"

# VAPID - legacy push fallback (used only if OneSignal is NOT configured)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="admin@yourdomain.com"

# SMTP email - legacy fallback (used only if OneSignal is NOT configured)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Laundry Booking <noreply@yourdomain.com>"
