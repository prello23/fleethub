generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
  

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  password         String
  role             String    @default("USER")
  apartment        String?
  pushSubscription String?
  createdAt        DateTime  @default(now())
  bookings         Booking[]
}

model Room {
  id                     String    @id @default(cuid())
  name                   String
  description            String?
  washingMachines        Int       @default(2)
  dryers                 Int       @default(1)
  slotDurationMinutes    Int       @default(60)
  notifyMinutesBefore    Int       @default(30)
  notifyMinutesBeforeEnd Int       @default(10)
  createdAt              DateTime  @default(now())
  bookings               Booking[]
}

model Booking {
  id            String   @id @default(cuid())
  roomId        String
  userId        String
  machineType   String
  machineNumber Int
  startTime     DateTime
  endTime       DateTime
  notifiedStart Boolean  @default(false)
  notifiedEnd   Boolean  @default(false)
  createdAt     DateTime @default(now())
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
